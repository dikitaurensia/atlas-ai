{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2020"],
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "baseUrl": ".",
    "outDir": "./dist-typeorm",
    "types": ["node"],
    "ignoreDeprecations": "6.0"
  },
  "ts-node": {
    "esm": false,
    "transpileOnly": true
  },
  "include": ["database/**/*.ts", "lib/entities/**/*.ts", "typeorm.config.ts"]
}
