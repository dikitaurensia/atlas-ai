# ─────────────────────────────────────────────────────
# Option A: Local Docker PostgreSQL (default)
# Start the database with: docker compose up db
# ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://atlas:atlas_dev@localhost:5432/atlas_ai

# ─────────────────────────────────────────────────────
# Option B: Neon (cloud PostgreSQL)
# Copy connection string from neon.tech dashboard
# ─────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate with: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# SETUP_TOKEN is deprecated — use: npm run migration:run
# SETUP_TOKEN=your-setup-token-here
