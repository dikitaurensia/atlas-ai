# Neon Postgres — copy connection string dari neon.tech dashboard
DATABASE_URL=postgres://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# JWT secret — generate random string, e.g: openssl rand -base64 32
JWT_SECRET=your-secret-key-here

# Setup token — untuk inisialisasi DB, bisa string apa saja
SETUP_TOKEN=your-setup-token-here
